{
  "name": "clean-kitchen-client",
  "version": "12.1.0",
  "private": true,
  "type": "module",
  "description": "Clean Kitchen — oshpaz uchun texnologik kartalar (client front-end)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:mock": "VITE_USE_MOCK=true vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "prebuild": "node scripts/copy-ocr.mjs",
    "predev": "node scripts/copy-ocr.mjs",
    "postinstall": "node scripts/copy-ocr.mjs",
    "postbuild": "node scripts/offline-manifest.mjs",
    "test:voice": "node scripts/test-voice.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}